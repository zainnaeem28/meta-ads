{
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "probe-scanner",
          "rules": [
            {
              "id": "probe-secret-1",
              "properties": { "security-severity": "7.5" }
            }
          ]
        }
      },
      "invocations": [{ "executionSuccessful": true }],
      "results": [
        {
          "ruleId": "probe-secret-1",
          "level": "error",
          "message": { "text": "synthetic secret finding (inert fixture)" },
          "locations": [
            { "physicalLocation": { "artifactLocation": { "uri": "example.env" } } }
          ]
        }
      ]
    }
  ]
}
