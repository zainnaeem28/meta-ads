# Generated from config/registry.json by `node scripts/ci/config-consistency.mjs --write`. Do not edit by hand.
# Names, classes and harmless local defaults only. Every value below is a local default for docker/compose.dev.yml;
# nothing here is a real credential. Real values live in the host secret store (docs/ops/secrets.md).
# Each process reads only its own keys and refuses a secret it must not hold, so split this file per process with
#   node scripts/ci/config-consistency.mjs --local-env .env.local.d
# which also generates the throwaway key material marked "generated". `.env.local.d` is git-ignored.
# A line starting with "# NAME=" is an optional key that is unset locally.

# --- Platform ---
# APP_ENV: public; read by api, worker, release, web, backup, monitor; required in api, worker, release, web, backup, monitor. One of development, test, staging, production.
APP_ENV=development
# RELEASE_SHA: public; read by api, worker, release; optional. 7 to 40 hex characters; required in staging and production.
# RELEASE_SHA=
# API_PORT: public; read by api; optional. Integer 1-65535.
API_PORT=4000
# WEB_ORIGIN: public; read by api, web; required in api, web. URL; https in staging and production.
WEB_ORIGIN=http://localhost:3000
# TRUST_PROXY_HOPS: public; read by api; optional. Integer 0-3.
TRUST_PROXY_HOPS=1
# LOG_LEVEL: public; read by api, worker, release, web, backup, monitor; optional. A pino level.
LOG_LEVEL=info
# SHOTSTACK_API_KEY: secret; read by worker; optional. See ARCHITECTURE section 6.
# SHOTSTACK_API_KEY=
# WORKER_WATCHDOG_SECONDS: public; read by worker; optional. See ARCHITECTURE section 6.
WORKER_WATCHDOG_SECONDS=180
# WORKER_DRAIN_SECONDS: public; read by worker; optional. See ARCHITECTURE section 6.
WORKER_DRAIN_SECONDS=25
# API_DRAIN_SECONDS: public; read by api; optional. See ARCHITECTURE section 6.
API_DRAIN_SECONDS=20

# --- Database ---
# DATABASE_URL: secret; read by api, worker; required in api, worker. PostgreSQL URL; TLS required in staging and production.
DATABASE_URL=postgres://postgres:shroomap-local@localhost:5432/shroomap_dev
# MIGRATION_DATABASE_URL: secret; read by release; required in release. PostgreSQL URL; absent from api and worker.
MIGRATION_DATABASE_URL=postgres://postgres:shroomap-local@localhost:5432/shroomap_dev
# DATABASE_POOL_MAX: public; read by api, worker; optional. See ARCHITECTURE section 6.
DATABASE_POOL_MAX=10
# DATABASE_ACQUIRE_TIMEOUT_MS: public; read by api, worker; optional. See ARCHITECTURE section 6.
DATABASE_ACQUIRE_TIMEOUT_MS=5000

# --- Identity ---
# CLERK_SECRET_KEY: secret; read by api, worker, web; required in api, worker, web. `sk_` prefix.
CLERK_SECRET_KEY=sk_local_not_a_real_key
# CLERK_JWT_ISSUER: public; read by api; required in api. https URL.
CLERK_JWT_ISSUER=https://clerk.local.invalid
# OWNER_EMAIL: public; read by api; optional. Valid email; required in production.
# OWNER_EMAIL=
# MFA_REQUIRED_FOR: public; read by api; optional. See ARCHITECTURE section 6.
MFA_REQUIRED_FOR=all
# RECENT_AUTH_MAX_AGE_MIN: public; read by api; optional. See ARCHITECTURE section 6.
RECENT_AUTH_MAX_AGE_MIN=10
# INVITE_EMAIL_DOMAINS: public; read by api; optional. See ARCHITECTURE section 6.
INVITE_EMAIL_DOMAINS=
# INVITE_EXPIRY_DAYS: public; read by api; optional. See ARCHITECTURE section 6.
INVITE_EXPIRY_DAYS=7
# ACCESS_REQUEST_FORM_ENABLED: public; read by api; optional. See ARCHITECTURE section 6.
ACCESS_REQUEST_FORM_ENABLED=false
# SIGNUP_OPEN_EMAIL_VERIFICATION: public; read by api; optional. See ARCHITECTURE section 6.
SIGNUP_OPEN_EMAIL_VERIFICATION=false
# SIGNUP_OPEN_RATE_LIMIT: public; read by api; optional. See ARCHITECTURE section 6.
SIGNUP_OPEN_RATE_LIMIT=false
# SIGNUP_OPEN_ABUSE_LIMITS: public; read by api; optional. See ARCHITECTURE section 6.
SIGNUP_OPEN_ABUSE_LIMITS=false
# INVITATION_SEND_STALE_MIN: public; read by worker; optional. See ARCHITECTURE section 6.
INVITATION_SEND_STALE_MIN=15

# --- Provider keys ---
# KEK_PUBLIC_KEYS: public; read by api, worker; required in api, worker. JSON map {version: RSA-3072 public PEM}.
KEK_PUBLIC_KEYS=
#   generated by --local-env: rsa3072-public
# KEK_ACTIVE_VERSION: public; read by api, worker; required in api, worker. Present in both KEK maps.
KEK_ACTIVE_VERSION=1
# KEK_PRIVATE_KEYS: secret; read by worker; required in worker. JSON map {version: PEM}; worker only.
KEK_PRIVATE_KEYS=
#   generated by --local-env: rsa3072-private
# KEY_FINGERPRINT_PEPPERS: secret; read by api; required in api. JSON map {version: base64}, 32+ bytes each.
KEY_FINGERPRINT_PEPPERS=
#   generated by --local-env: pepper-map
# KEY_FINGERPRINT_PEPPER_ACTIVE: public; read by api; required in api. Present in the pepper map.
KEY_FINGERPRINT_PEPPER_ACTIVE=1
# KEY_ENTRY_ATTEMPTS_PER_WINDOW: public; read by api; optional. See ARCHITECTURE section 6.
KEY_ENTRY_ATTEMPTS_PER_WINDOW=5
# KEY_ENTRY_WINDOW_MIN: public; read by api; optional. See ARCHITECTURE section 6.
KEY_ENTRY_WINDOW_MIN=10
# KEY_AUTO_DISABLE_THRESHOLD: public; read by worker; optional. See ARCHITECTURE section 6.
KEY_AUTO_DISABLE_THRESHOLD=5
# KEY_FORMAT_OPENAI: public; read by api; optional. See ARCHITECTURE section 6.
KEY_FORMAT_OPENAI=^sk-[A-Za-z0-9_-]{20,}$
# KEY_FORMAT_WAVESPEED: public; read by api; optional. See ARCHITECTURE section 6.
KEY_FORMAT_WAVESPEED=^[A-Za-z0-9_-]{20,}$
# PROBE_TIMEOUT_MS: public; read by api; optional. See ARCHITECTURE section 6.
PROBE_TIMEOUT_MS=5000

# --- Storage ---
# R2_ENDPOINT: public; read by api, worker, backup; required in api, worker, backup. URL; https in staging and production.
R2_ENDPOINT=http://localhost:9000
# R2_BUCKET: public; read by api, worker; required in api, worker. Non-empty.
R2_BUCKET=app
# R2_ACCESS_KEY_ID: secret; read by api, worker; required in api, worker. Non-empty; distinct per process.
R2_ACCESS_KEY_ID=shroomap-local
# R2_SECRET_ACCESS_KEY: secret; read by api, worker; required in api, worker. Non-empty; distinct per process.
R2_SECRET_ACCESS_KEY=shroomap-local-secret
# R2_LEDGER_BUCKET: public; read by worker, backup; required in worker, backup. Non-empty; differs from R2_BUCKET.
R2_LEDGER_BUCKET=ledger
# R2_LEDGER_ACCESS_KEY_ID: secret; read by worker; required in worker. Non-empty; differs from token B.
R2_LEDGER_ACCESS_KEY_ID=shroomap-local-ledger
# R2_LEDGER_SECRET_ACCESS_KEY: secret; read by worker; required in worker. Non-empty; differs from token B.
R2_LEDGER_SECRET_ACCESS_KEY=shroomap-local-ledger-secret
# STORAGE_PUBLIC_ORIGIN: public; read by api; optional. See ARCHITECTURE section 6.
# STORAGE_PUBLIC_ORIGIN=
# MEDIA_MAX_UPLOAD_BYTES: public; read by api; optional. See ARCHITECTURE section 6.
MEDIA_MAX_UPLOAD_BYTES=10485760
# MEDIA_MAX_PIXEL_DIMENSION: public; read by worker; optional. See ARCHITECTURE section 6.
MEDIA_MAX_PIXEL_DIMENSION=8000
# MEDIA_MAX_PIXELS: public; read by worker; optional. See ARCHITECTURE section 6.
MEDIA_MAX_PIXELS=40000000
# MEDIA_BROWSER_URL_TTL_SEC: public; read by api; optional. See ARCHITECTURE section 6.
MEDIA_BROWSER_URL_TTL_SEC=300
# MEDIA_UNATTACHED_TTL_HOURS: public; read by worker; optional. See ARCHITECTURE section 6.
MEDIA_UNATTACHED_TTL_HOURS=24
# STORAGE_QUOTA_BYTES: public; read by api; optional. See ARCHITECTURE section 6.
STORAGE_QUOTA_BYTES=21474836480

# --- Limits and caps ---
# SPEND_CAP_DAILY_USD: public; read by api; optional. See ARCHITECTURE section 6.
SPEND_CAP_DAILY_USD=50
# SPEND_CAP_MONTHLY_USD: public; read by api; optional. See ARCHITECTURE section 6.
SPEND_CAP_MONTHLY_USD=500
# JOB_BURST_ALERT_COUNT: public; read by api; optional. See ARCHITECTURE section 6.
JOB_BURST_ALERT_COUNT=20
# JOB_BURST_WINDOW_MIN: public; read by api; optional. See ARCHITECTURE section 6.
JOB_BURST_WINDOW_MIN=10
# PROVIDER_AUTH_SPIKE_COUNT: public; read by worker; optional. See ARCHITECTURE section 6.
PROVIDER_AUTH_SPIKE_COUNT=5
# PROVIDER_AUTH_SPIKE_WINDOW_MIN: public; read by worker; optional. See ARCHITECTURE section 6.
PROVIDER_AUTH_SPIKE_WINDOW_MIN=10
# JOB_CREATE_RATE_LIMIT: public; read by api; optional. See ARCHITECTURE section 6.
JOB_CREATE_RATE_LIMIT=60
# JOB_CREATE_RATE_WINDOW_MIN: public; read by api; optional. See ARCHITECTURE section 6.
JOB_CREATE_RATE_WINDOW_MIN=10
# RATE_LIMIT_IP_KEY: secret; read by api; required in api. 32+ bytes.
RATE_LIMIT_IP_KEY=
#   generated by --local-env: random
# RUNNING_JOBS_PER_USER: public; read by worker; optional. See ARCHITECTURE section 6.
RUNNING_JOBS_PER_USER=5
# ASSEMBLY_RENDERS_PER_USER_PER_DAY: public; read by api; optional. See ARCHITECTURE section 6.
ASSEMBLY_RENDERS_PER_USER_PER_DAY=20
# IDEMPOTENCY_TTL_HOURS: public; read by api; optional. See ARCHITECTURE section 6.
IDEMPOTENCY_TTL_HOURS=24
# REPORT_DEFAULT_WINDOW_DAYS: public; read by api; optional. See ARCHITECTURE section 6.
REPORT_DEFAULT_WINDOW_DAYS=30
# REPORT_MAX_WINDOW_DAYS: public; read by api; optional. See ARCHITECTURE section 6.
REPORT_MAX_WINDOW_DAYS=366

# --- Jobs and provider calls ---
# PROVIDER_FETCH_URL_TTL_SEC: public; read by worker; optional. See ARCHITECTURE section 6.
PROVIDER_FETCH_URL_TTL_SEC=3600
# ASSEMBLY_ADAPTER: public; read by worker; optional. See ARCHITECTURE section 6.
ASSEMBLY_ADAPTER=ffmpeg
# ASSEMBLY_VENDOR_PLATFORM_CAP: public; read by worker; optional. See ARCHITECTURE section 6.
# ASSEMBLY_VENDOR_PLATFORM_CAP=
# ASSEMBLY_CONCURRENCY: public; read by worker; optional. See ARCHITECTURE section 6.
ASSEMBLY_CONCURRENCY=1
# THUMBSTOPPER_FRAME_SECONDS: public; read by worker; optional. See ARCHITECTURE section 6.
THUMBSTOPPER_FRAME_SECONDS=1.5
# PROVIDER_HTTP_TIMEOUT_MS: public; read by worker; optional. See ARCHITECTURE section 6.
PROVIDER_HTTP_TIMEOUT_MS=120000
# SUBMIT_JOB_EXPIRE_SEC: public; read by worker; optional. See ARCHITECTURE section 6.
SUBMIT_JOB_EXPIRE_SEC=150
# SUBMIT_ORPHAN_AFTER_SEC: public; read by worker; optional. See ARCHITECTURE section 6.
SUBMIT_ORPHAN_AFTER_SEC=300
# POLL_INTERVAL_SEC: public; read by worker; optional. See ARCHITECTURE section 6.
POLL_INTERVAL_SEC=5
# POLL_LEASE_SEC: public; read by worker; optional. See ARCHITECTURE section 6.
POLL_LEASE_SEC=60
# VIDEO_JOB_DEADLINE_MIN: public; read by worker; optional. See ARCHITECTURE section 6.
VIDEO_JOB_DEADLINE_MIN=30
# PROVIDER_OUTPUT_COPY_WINDOW_HOURS: public; read by worker; optional. See ARCHITECTURE section 6.
PROVIDER_OUTPUT_COPY_WINDOW_HOURS=24
# PROVIDER_OUTPUT_MAX_BYTES: public; read by worker; optional. See ARCHITECTURE section 6.
PROVIDER_OUTPUT_MAX_BYTES=209715200
# EGRESS_ALLOWED_HOSTS: public; read by api, worker; optional. JSON map vendor to exact hosts or *.domain suffixes.
EGRESS_ALLOWED_HOSTS={"openai":["api.openai.com"],"wavespeed":["api.wavespeed.ai"]}
# WORKER_PROVIDER_ORIGIN_OVERRIDE: public; read by worker; optional. Test seam: https origin (a name, port 443, no path) that replaces api.wavespeed.ai and api.openai.com for the WaveSpeed and QC calls; only when APP_ENV is development or test (refused in staging and production); its host must be named exactly under both openai and wavespeed in EGRESS_ALLOWED_HOSTS.
# WORKER_PROVIDER_ORIGIN_OVERRIDE=
# WORKER_CONCURRENCY_PROVIDER: public; read by worker; optional. See ARCHITECTURE section 6.
WORKER_CONCURRENCY_PROVIDER=20
# WORKER_CONCURRENCY_SANITIZE: public; read by worker; optional. See ARCHITECTURE section 6.
WORKER_CONCURRENCY_SANITIZE=2
# WORKER_CONCURRENCY_DELETION: public; read by worker; optional. See ARCHITECTURE section 6.
WORKER_CONCURRENCY_DELETION=2

# --- Providers and models ---
# WAVESPEED_MODEL_I2V: public; read by worker; optional. See ARCHITECTURE section 6.
WAVESPEED_MODEL_I2V=bytedance/seedance-2.0/image-to-video
# WAVESPEED_MODEL_T2V: public; read by worker; optional. See ARCHITECTURE section 6.
WAVESPEED_MODEL_T2V=bytedance/seedance-2.0/text-to-video
# VIDEO_RESOLUTION: public; read by worker; optional. See ARCHITECTURE section 6.
VIDEO_RESOLUTION=1080p
# VIDEO_ASPECT_RATIO: public; read by worker; optional. See ARCHITECTURE section 6.
VIDEO_ASPECT_RATIO=9:16
# VIDEO_SEGMENT_SECONDS: public; read by worker; optional. See ARCHITECTURE section 6.
VIDEO_SEGMENT_SECONDS=15
# OPENAI_TEXT_MODEL: public; read by worker; optional. See ARCHITECTURE section 6.
OPENAI_TEXT_MODEL=local-stub-text
# OPENAI_VISION_MODEL: public; read by worker; optional. See ARCHITECTURE section 6.
OPENAI_VISION_MODEL=local-stub-vision
# OPENAI_TRANSCRIBE_MODEL: public; read by worker; optional. See ARCHITECTURE section 6.
OPENAI_TRANSCRIBE_MODEL=gpt-transcribe
# OPENAI_IMAGE_MODEL: public; read by worker; optional. See ARCHITECTURE section 6.
OPENAI_IMAGE_MODEL=local-stub-image
# QC_MAX_WORD_ERROR_RATE: public; read by worker; optional. See ARCHITECTURE section 6.
QC_MAX_WORD_ERROR_RATE=0.20
# PROVIDER_DATA_MODE_OPENAI: public; read by worker; optional. See ARCHITECTURE section 6.
PROVIDER_DATA_MODE_OPENAI=synthetic
# PROVIDER_DATA_MODE_WAVESPEED: public; read by worker; optional. See ARCHITECTURE section 6.
PROVIDER_DATA_MODE_WAVESPEED=synthetic
# PROVIDER_DATA_MODE_SHOTSTACK: public; read by worker; optional. See ARCHITECTURE section 6.
PROVIDER_DATA_MODE_SHOTSTACK=synthetic

# --- Lifecycle ---
# CURSOR_SIGNING_KEY: secret; read by api; required in api. 32+ bytes.
CURSOR_SIGNING_KEY=
#   generated by --local-env: random
# ERASURE_HOLD_PERIOD_HOURS: public; read by api; optional. See ARCHITECTURE section 6.
ERASURE_HOLD_PERIOD_HOURS=0
# DELETION_RETRY_LIMIT: public; read by worker; optional. See ARCHITECTURE section 6.
DELETION_RETRY_LIMIT=10

# --- Observability ---
# HEARTBEAT_URL_WORKER: secret; read by worker; optional. https URL.
# HEARTBEAT_URL_WORKER=
# METRICS_TOKEN: secret; read by api, monitor; optional. 43+ base64url characters; required in staging and production.
# METRICS_TOKEN=
# SENTRY_DSN: secret; read by api, worker, monitor; optional. https DSN.
# SENTRY_DSN=
# SENTRY_ENVIRONMENT: public; read by api, worker, web, monitor; optional. [a-z0-9-]{1,32}; defaults to APP_ENV.
# SENTRY_ENVIRONMENT=
# SENTRY_ERRORS_SAMPLE_RATE: public; read by api, worker, web; optional. See ARCHITECTURE section 6.
SENTRY_ERRORS_SAMPLE_RATE=1.0
# SENTRY_TRACES_SAMPLE_RATE: public; read by api, worker, web; optional. See ARCHITECTURE section 6.
SENTRY_TRACES_SAMPLE_RATE=0
# HEARTBEAT_URL_MONITOR: secret; read by monitor; optional. https URL.
# HEARTBEAT_URL_MONITOR=

# --- Web build ---
# NEXT_PUBLIC_API_ORIGIN: public; read by web; required in web. URL; https in staging and production. Inlined at build; the web image is built per environment.
NEXT_PUBLIC_API_ORIGIN=http://localhost:4000
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY: public; read by web; required in web. `pk_` prefix. Inlined at build.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_local_not_a_real_key
# NEXT_PUBLIC_SENTRY_DSN: public; read by web; optional. https DSN; same Sentry organisation as SENTRY_DSN. Visible in the browser by design.
# NEXT_PUBLIC_SENTRY_DSN=

# --- Backup ---
# BACKUP_DATABASE_URL: secret; read by backup; required in backup. PostgreSQL URL (role `app_backup`), TLS outside development; never named DATABASE_URL.
BACKUP_DATABASE_URL=postgres://postgres:shroomap-local@localhost:5432/shroomap_dev
# R2_BACKUP_SOURCE_ACCESS_KEY_ID: secret; read by backup; required in backup. Object Read only token on the app and ledger buckets.
R2_BACKUP_SOURCE_ACCESS_KEY_ID=shroomap-local
# R2_BACKUP_SOURCE_SECRET_ACCESS_KEY: secret; read by backup; required in backup. Object Read only token on the app and ledger buckets.
R2_BACKUP_SOURCE_SECRET_ACCESS_KEY=shroomap-local-secret
# R2_BACKUP_SINK_ACCESS_KEY_ID: secret; read by backup; required in backup. Object Read and Write token on the backup bucket only; not Admin.
R2_BACKUP_SINK_ACCESS_KEY_ID=shroomap-local
# R2_BACKUP_SINK_SECRET_ACCESS_KEY: secret; read by backup; required in backup. Object Read and Write token on the backup bucket only; not Admin.
R2_BACKUP_SINK_SECRET_ACCESS_KEY=shroomap-local-secret
# HEARTBEAT_URL_BACKUP: secret; read by backup; required in backup. https URL.
# HEARTBEAT_URL_BACKUP=
# BACKUP_AGE_RECIPIENT: public; read by backup; required in backup. `age1` public recipient; the private key is never present.
BACKUP_AGE_RECIPIENT=age1ql3z7hjy54pw3hyww5ayyfg7zqgvc7w3j2elw8zmrj2kg5sfn9aqmcac8p
# R2_BACKUP_BUCKET: public; read by backup; required in backup. Non-empty; three distinct bucket names.
R2_BACKUP_BUCKET=backup
# BACKUP_RETENTION_DAYS: public; read by backup; optional. Integer 7-365; equals the Admin-set lock age (DO-07).
BACKUP_RETENTION_DAYS=30

# --- Local mode ---
# IDENTITY_MODE: public; read by api; optional. `local` or `clerk`; `local` is refused when APP_ENV is staging or production.
#   Refused when APP_ENV is staging or production.
IDENTITY_MODE=local
# AUTH_MODE: public; read by web; optional. `local` or `clerk`; `local` is refused when APP_ENV is staging or production.
#   Refused when APP_ENV is staging or production.
AUTH_MODE=local
