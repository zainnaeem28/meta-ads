{
  "name": "@shroomap/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.api.js",
    "lint": "eslint src",
    "test:unit": "vitest run --config vitest.config.ts --coverage; rc=$?; mkdir -p reports/egress && cp reports/http/lcov.info reports/egress/lcov.info; exit $rc",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:startup-config": "vitest run --config vitest.config.ts src/platform/config/schema.test.ts src/platform/config/example-env.test.ts; rc=$?; mkdir -p ../../reports/config && cp reports/config/junit.xml ../../reports/config/junit.xml; exit $rc"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1169.0",
    "@aws-sdk/s3-request-presigner": "3.1169.0",
    "@clerk/backend": "3.29.0",
    "@fastify/helmet": "13.2.0",
    "@fastify/multipart": "10.1.8",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-fastify": "12.5.0",
    "@sentry/node": "11.12.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.8",
    "nestjs-pino": "5.3.1",
    "openai": "7.57.0",
    "pg": "8.23.1",
    "pg-boss": "12.38.2",
    "pino": "10.4.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "sharp": "0.35.5",
    "undici": "8.12.4",
    "uuid": "14.0.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "@vitest/coverage-v8": "5.1.0",
    "drizzle-kit": "0.31.11",
    "typescript": "6.0.3",
    "vitest": "5.1.0"
  }
}
