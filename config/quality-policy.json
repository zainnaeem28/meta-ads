{
  "version": 1,
  "owner": "QUALITY-RELEASE-PLAN sections 4, 5 and DEVOPS-PLAN section 4.3",
  "severity": {
    "cvss": { "critical": 9.0, "high": 7.0, "medium": 4.0, "low": 0.1 },
    "sarifLevel": { "error": "high", "warning": "medium", "note": "low", "none": "info" },
    "words": {
      "critical": "critical",
      "high": "high",
      "medium": "medium",
      "moderate": "medium",
      "low": "low",
      "info": "info",
      "informational": "info",
      "negligible": "info"
    },
    "zapRiskCode": { "3": "high", "2": "medium", "1": "low", "0": "info" },
    "missing": "high"
  },
  "failOn": {
    "default": "high",
    "sources": { "zap": "medium" },
    "pathClasses": [
      {
        "name": "key-custody",
        "paths": [
          "(^|/)modules/provider-keys/",
          "(^|/)modules/identity/",
          "(^|/)platform/egress/",
          "(^|/)modules/media/.*sign"
        ],
        "failOn": "medium",
        "promoteTo": "high"
      }
    ]
  },
  "customRules": {
    "owner": "TASK-115 (SECURITY-DESIGN section 14), reviewed by the Security Reviewer",
    "semgrep": {
      "file": "config/semgrep/shroomap-security.yml",
      "ids": [
        "shroomap.key-custody.no-withdecryptedkey-outside-worker",
        "shroomap.egress.no-raw-http-outside-platform-egress",
        "shroomap.sql.no-interpolated-identifiers",
        "shroomap.process.no-shell-string-spawn",
        "shroomap.key-custody.no-unprojected-provider-keys-select"
      ]
    },
    "gitleaks": {
      "file": "config/gitleaks.toml",
      "ids": ["openai-key-shaped", "wavespeed-key-prefixed", "wavespeed-key-assigned"]
    },
    "keyCustodyOverride": "failOn.pathClasses[name=key-custody]: Medium is promoted to High until dispositioned"
  },
  "dispositions": { "maxDays": 90, "neverDismiss": ["critical"] },
  "nonBlocking": { "owner": "DevOps Engineer", "dueDays": 30 },
  "coverage": {
    "classes": {
      "authentication": { "lines": 90, "branches": 85 },
      "overall": { "lines": 80, "branches": 75 },
      "utilities": { "lines": 95, "branches": 90 },
      "ui-components": { "lines": 75, "branches": 70 },
      "hooks": { "lines": 85, "branches": 80 }
    }
  },
  "profiles": ["ticket", "release"],
  "reports": [
    {
      "id": "lint",
      "kind": "summary",
      "report": "lint/summary.json",
      "profiles": ["ticket", "release"]
    },
    {
      "id": "types",
      "kind": "summary",
      "report": "types/summary.json",
      "profiles": ["ticket", "release"]
    },
    {
      "id": "layers",
      "kind": "summary",
      "report": "layers/summary.json",
      "profiles": ["ticket", "release"]
    },
    {
      "id": "unit-ci",
      "kind": "junit",
      "report": "ci/junit.xml",
      "coverage": "ci/lcov.info",
      "coverageClass": "overall",
      "minTests": 1,
      "profiles": ["ticket", "release"]
    },
    {
      "id": "contract",
      "kind": "summary",
      "report": "contract/summary.json",
      "stubAllowed": "TASK-019",
      "stubWhenAbsent": ["packages/contracts/openapi.yaml"],
      "profiles": ["ticket", "release"]
    },
    {
      "id": "sast",
      "kind": "findings",
      "report": "sast.sarif",
      "profiles": ["ticket", "release"]
    },
    {
      "id": "deps",
      "kind": "findings",
      "report": "deps.sarif",
      "profiles": ["ticket", "release"]
    },
    {
      "id": "deps-audit",
      "kind": "findings",
      "report": "audit.json",
      "profiles": ["ticket", "release"]
    },
    {
      "id": "secrets",
      "kind": "secrets",
      "report": "secrets.sarif",
      "profiles": ["ticket", "release"]
    },
    {
      "id": "integration",
      "kind": "junit",
      "report": "integration/junit.xml",
      "minTests": 1,
      "profiles": ["release"]
    },
    {
      "id": "e2e",
      "kind": "junit",
      "report": "e2e/junit.xml",
      "minTests": 1,
      "notApplicableWhenAbsent": ["playwright.config.ts", "apps/web/playwright.config.ts"],
      "profiles": ["release"]
    },
    {
      "id": "container",
      "kind": "findings",
      "report": "container.sarif",
      "notApplicableWhenAbsent": ["docker", "Dockerfile", "apps/api/Dockerfile"],
      "profiles": ["release"]
    },
    {
      "id": "iac",
      "kind": "findings",
      "report": "iac.sarif",
      "notApplicableWhenAbsent": [
        "docker",
        "infra",
        "Dockerfile",
        "docker-compose.yml",
        "compose.yaml",
        ".github/workflows"
      ],
      "profiles": ["release"]
    },
    {
      "id": "build",
      "kind": "summary",
      "report": "build/summary.json",
      "profiles": ["release"]
    }
  ],
  "baselines": {
    "owner": "QUALITY-RELEASE-PLAN sections 6 and 7 (TC-NFR-01, TC-NFR-02, TC-NFR-10); scripts: tests/baselines, scripts/ci/dast.sh, load.sh, lighthouse.sh",
    "dast": {
      "tool": "OWASP ZAP baseline (spider and passive scan, no active attack)",
      "contexts": ["anonymous", "user", "admin"],
      "failOnSource": "zap",
      "maxUnauthorizedShare": 0.5,
      "minAuthenticatedRequests": 20
    },
    "load": {
      "accounts": 25,
      "virtualUsers": 10,
      "stubJobsPerAccount": 5,
      "thinkTimeSec": 3,
      "pollIntervalSec": 3,
      "rampSec": 60,
      "steadySec": 600,
      "readShare": 0.8,
      "p95Ms": 500,
      "maxErrorRate": 0.01,
      "maxUnauthorizedShare": 0.05,
      "minRequests": 1000
    },
    "frontend": {
      "samplesPerRoute": 5,
      "profiles": ["mobile", "desktop"],
      "lcpMs": 2500,
      "inpMs": 200,
      "cls": 0.1,
      "tbtMs": 200,
      "routes": [
        { "id": "sign-in", "path": "/sign-in", "session": "none" },
        { "id": "history", "path": "/campaigns", "session": "user" },
        { "id": "intake-wizard", "path": "/campaigns/new", "session": "user" },
        { "id": "brief-review", "path": "/campaigns/{campaign}/brief", "session": "user" },
        { "id": "clips-status", "path": "/campaigns/{campaign}/clips", "session": "user" },
        { "id": "review-download", "path": "/campaigns/{campaign}/final", "session": "user" },
        { "id": "key-management", "path": "/settings/provider-keys", "session": "user" },
        { "id": "admin-usage-report", "path": "/admin/usage", "session": "admin" }
      ]
    }
  },
  "workflow": {
    "file": ".github/workflows/ci.yml",
    "requiredJobs": [
      "validate",
      "unit",
      "integration",
      "e2e",
      "security",
      "build",
      "container-scan",
      "dast-baseline",
      "quality-gate"
    ],
    "allowedPermissions": ["contents: read", "actions: read", "packages: write", "id-token: write"],
    "forbiddenTriggers": ["pull_request_target", "schedule"]
  }
}
